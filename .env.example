# TrendRadar — Environment Configuration

# 1. Google Gemini AI API (Required for dynamic AI deep dive & live AI chat)
# Get a key at: https://aistudio.google.com
GEMINI_API_KEY=

# 2. Supabase Integration (Optional: for cloud persistence of watchlists and saved trends)
# Get credentials at: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 3. Social Platform APIs (Optional for elevated rate limits / private feeds)
# Reddit OAuth App: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# YouTube Data API v3: https://console.cloud.google.com
YOUTUBE_API_KEY=

# X (Twitter) Developer Portal: https://developer.x.com
TWITTER_BEARER_TOKEN=

# Meta Graph API: https://developers.facebook.com
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=

# TikTok Commercial / Research API: https://developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
